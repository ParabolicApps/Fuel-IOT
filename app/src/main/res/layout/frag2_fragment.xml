<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor"
    android:orientation="vertical"
    android:padding="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Top Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/fuel_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_analytics"
                    app:tint="@color/neon_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/fuel_icon"
                    android:text="FUEL GUARD"
                    android:textColor="?attr/appHeaderTextColor"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <ImageView
                    android:id="@+id/settings_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/baseline_settings_24"
                    app:tint="?attr/appIconTint"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </RelativeLayout>

            <!-- Period Selector Spinner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glow_blue"
                android:padding="6dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical">

                <Spinner
                    android:id="@+id/range_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:dropDownSelector="?attr/appCardBackgroundColor"
                    android:popupBackground="?attr/appCardBackgroundColor"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <!-- Total Refuelled Chart Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glow_blue"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="28dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/chart_icon1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_apps_24"
                        app:tint="@color/neon_blue" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/chart_icon1"
                        android:layout_marginStart="10dp"
                        android:text="TOTAL REFUELLED"
                        android:textColor="?attr/appSubTextColor"
                        android:textSize="14sp"
                        android:letterSpacing="0.05" />
                    <TextView
                        android:id="@+id/total_refill_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="250\nLiters Total"
                        android:textColor="@color/neon_blue"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:textStyle="bold"/>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <lecho.lib.hellocharts.view.LineChartView
                        android:id="@+id/chart"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_alignParentBottom="true" />

                    <!-- Custom Tooltip 1 -->
                    <LinearLayout
                        android:id="@+id/tooltip1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/tooltip_bg"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:elevation="6dp">
                            <TextView
                                android:id="@+id/tooltip1_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="May 15"
                                android:textColor="?attr/appSubTextColor"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tooltip1_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Refueled: 50.0 Ltrs"
                                android:textColor="?attr/appContentTextColor"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:id="@+id/tooltip1_line"
                            android:layout_width="1.5dp"
                            android:layout_height="150dp"
                            android:background="@color/neon_blue"
                            android:alpha="0.3" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

            <!-- Engine Consumed Chart Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glow_orange"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="28dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/chart_icon2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_apps_24"
                        app:tint="@color/neon_orange" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/chart_icon2"
                        android:layout_marginStart="10dp"
                        android:text="ENGINE CONSUMED"
                        android:textColor="?attr/appSubTextColor"
                        android:textSize="14sp"
                        android:letterSpacing="0.05" />
                    <TextView
                        android:id="@+id/total_consume_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="185\nLiters Total"
                        android:textColor="@color/neon_orange"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:textStyle="bold"/>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <lecho.lib.hellocharts.view.LineChartView
                        android:id="@+id/chart2"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_alignParentBottom="true" />

                    <!-- Custom Tooltip 2 -->
                    <LinearLayout
                        android:id="@+id/tooltip2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/tooltip_bg"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:elevation="6dp">
                            <TextView
                                android:id="@+id/tooltip2_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="May 15"
                                android:textColor="?attr/appSubTextColor"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tooltip2_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Consumed: 4.2 Liters"
                                android:textColor="?attr/appContentTextColor"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:id="@+id/tooltip2_line"
                            android:layout_width="1.5dp"
                            android:layout_height="150dp"
                            android:background="@color/neon_orange"
                            android:alpha="0.3" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

            <!-- Hidden Views -->
            <RadioGroup
                android:id="@+id/radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/container2"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#33FFFFFF"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>