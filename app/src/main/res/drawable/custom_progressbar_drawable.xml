<?xml version="1.0" encoding="utf-8" ?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <rotate
            android:fromDegrees="270.0"
            android:toDegrees="270.0"
            android:pivotX="50.0%"
            android:pivotY="50.0%">
            <shape
                android:shape="ring"
                android:innerRadiusRatio="3.0"
                android:useLevel="false"
                android:thickness="10.0dip">
                <solid
                    android:color="#ffcfd8dc"/>
            </shape>
        </rotate>
    </item>
    <item>
        <rotate
            android:fromDegrees="270.0"
            android:toDegrees="270.0"
            android:pivotX="50.0%"
            android:pivotY="50.0%">
            <shape
                android:shape="ring"
                android:innerRadiusRatio="3.0"
                android:useLevel="true"
                android:thickness="10.0dip">
                <solid
                    android:color="#ff2196f3"/>
            </shape>
        </rotate>
    </item>
</layer-list>